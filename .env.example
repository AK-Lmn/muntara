# Copy to .env.local and use only the public Supabase publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Browser map settings. Attribution is trusted maintainer-configured Leaflet HTML.
# Standard OSM tiles are best-effort with no SLA. See https://operations.osmfoundation.org/policies/tiles/
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>'
