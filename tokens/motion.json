{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Short transitions for direct feedback. Respect reduced motion.",
  "duration": {
    "instant": { "$type": "duration", "$value": "0ms" },
    "fast": { "$type": "duration", "$value": "100ms" },
    "base": { "$type": "duration", "$value": "180ms" }
  },
  "easing": {
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  }
}
