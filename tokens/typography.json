{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Muntara typography scale for readable service information.",
  "fontFamily": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"]
    }
  },
  "fontSize": {
    "caption": { "$type": "dimension", "$value": "0.75rem" },
    "body-sm": { "$type": "dimension", "$value": "0.875rem" },
    "body": { "$type": "dimension", "$value": "1rem" },
    "display": { "$type": "dimension", "$value": "2.5rem" },
    "display-lg": { "$type": "dimension", "$value": "3.25rem" }
  },
  "lineHeight": {
    "tight": { "$type": "number", "$value": 1.1 },
    "body": { "$type": "number", "$value": 1.55 }
  }
}
